<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>LavistechFileToolkit</AssemblyName>
    <RootNamespace>LavistechFileToolkit</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>Lavistech Solutions</Authors>
    <Description>Offline file toolkit for rename, sync, hash, PDF, archive, and image tools.</Description>
  </PropertyGroup>
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="LICENSE" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="EULA.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="PDFsharp" Version="6.2.1" />
    <PackageReference Include="SharpCompress" Version="0.50.11" />
    <PackageReference Include="SkiaSharp" Version="3.119.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.0" />
  </ItemGroup>
</Project>
