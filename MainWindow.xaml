<Window x:Class="LavistechFileToolkit.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="LavistechFileToolkit" Height="820" Width="1380" MinHeight="680" MinWidth="1050"
 WindowStartupLocation="CenterScreen" Background="#111B29" Foreground="#EAF0F8"
 AllowDrop="True" PreviewDragOver="Window_DragOver" Drop="Window_Drop">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.Column="0" Background="{StaticResource Sidebar}">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="18,22,18,22">
     <TextBlock Text="Lavistech FileToolkit" FontSize="16" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
     <TextBlock Text="FILE TOOLKIT  •  1.0.0" FontSize="10" Foreground="#91A4BD" Margin="3,5,0,20"/>
     <TextBox x:Name="SearchBox" Height="34" AcceptsReturn="False" VerticalScrollBarVisibility="Disabled" TextChanged="SearchBox_TextChanged" ToolTip="Search modules"/>
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="Private • Offline • Windows" Foreground="#8094AE" FontSize="10" Margin="18,15"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
     <StackPanel x:Name="NavPanel" Margin="10,0">
      <TextBlock Text="WORKSPACE" Foreground="#8094AE" FontSize="10" FontWeight="Bold" Margin="12,5,0,8"/>
      <Button Tag="Dashboard" Content="⌂   Dashboard" Click="Nav_Click" Background="#3985F5" Foreground="White" HorizontalContentAlignment="Left"/>
      <TextBlock Text="FILE OPERATIONS" Foreground="#8094AE" FontSize="10" FontWeight="Bold" Margin="12,20,0,8"/>
      <Button Tag="Bulk Rename" Content="✎   Bulk Rename" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
      <Button Tag="Duplicate Finder" Content="▦   Duplicate Finder" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
      <Button Tag="File Hashing" Content="#   File Hashing" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
      <Button Tag="Folder Compare" Content="⇄   Folder Compare" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
      <Button Tag="Folder Sync" Content="↻   Folder Sync" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
      <Button Tag="File Metadata" Content="☰   File Metadata" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
      <TextBlock Text="IMAGE TOOLS" Foreground="#8094AE" FontSize="10" FontWeight="Bold" Margin="12,20,0,8"/>
      <Button Tag="Image Resizer" Content="▧   Image Resizer" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
      <Button Tag="Format Converter" Content="⇩   Format Converter" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
      <Button Tag="Image Compress" Content="▣   Image Compress" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
      <TextBlock Text="DOCUMENTS" Foreground="#8094AE" FontSize="10" FontWeight="Bold" Margin="12,20,0,8"/>
      <Button Tag="PDF Tools" Content="▤   PDF Tools" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
      <Button Tag="Archives" Content="▩   Archives" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
      <TextBlock Text="SYSTEM" Foreground="#8094AE" FontSize="10" FontWeight="Bold" Margin="12,20,0,8"/>
      <Button Tag="About" Content="ⓘ   About" Click="Nav_Click" Background="Transparent" Foreground="#D5DFEA" HorizontalContentAlignment="Left"/>
     </StackPanel>
    </ScrollViewer>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1" Margin="30,25,30,25">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Margin="0,0,0,22">
    <TextBlock x:Name="PageTitle" Text="File Toolkit Dashboard" FontSize="27" FontWeight="Bold"/>
    <TextBlock x:Name="PageSubtitle" Text="A practical toolbox for managing, comparing and converting files" Foreground="{StaticResource Muted}" Margin="0,6,0,0"/>
   </StackPanel>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <Grid>
     <StackPanel x:Name="Dashboard">
      <Border CornerRadius="14" Padding="22" Margin="0,0,0,16">
       <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#155E75"/><GradientStop Color="#2765A7" Offset="0.55"/><GradientStop Color="#6041A5" Offset="1"/></LinearGradientBrush></Border.Background>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="1.4*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <StackPanel Margin="0,0,18,0">
         <TextBlock Text="Your files. Your tools." FontSize="25" FontWeight="Bold"/>
         <TextBlock Text="Manage, inspect and convert files privately on your PC." Foreground="#D5E7F8" Margin="0,8,0,16"/>
         <TextBlock Text="LOCAL PROCESSING  •  NO CLOUD UPLOADS" FontSize="10" Foreground="#D6E8F8"/>
        </StackPanel>
        <Border Grid.Column="1" Background="#243A48" CornerRadius="10" Padding="15" Margin="4">
         <StackPanel><TextBlock Text="WORKSPACE" Foreground="#AFC4D7" FontSize="10"/><TextBlock x:Name="WorkspaceStatus" Text="Ready" FontSize="22" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="Choose a tool from the sidebar" Foreground="#D5E0EC" TextWrapping="Wrap"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#34365B" CornerRadius="10" Padding="15" Margin="4">
         <StackPanel><TextBlock Text="SUPPORTED IMAGE FORMATS" Foreground="#C8C8E7" FontSize="10"/><TextBlock Text="PNG • JPG • WebP" FontSize="18" FontWeight="SemiBold" Margin="0,8,0,4"/><TextBlock Text="BMP • GIF • TIFF" Foreground="#D8D6F0"/></StackPanel>
        </Border>
       </Grid>
      </Border>
      <UniformGrid Columns="3">
       <Button Tag="Bulk Rename" Click="Nav_Click" Background="#243244" Foreground="White" Height="132" Margin="0,0,12,12" Padding="18" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="✎  Bulk Rename" FontSize="16" FontWeight="Bold"/><TextBlock Text="Rename many files with a preview" Foreground="#AAB8C9" Margin="0,10,0,8"/><TextBlock Text="Open tool →" Foreground="#70A8FF"/></StackPanel></Button>
       <Button Tag="Duplicate Finder" Click="Nav_Click" Background="#243244" Foreground="White" Height="132" Margin="0,0,12,12" Padding="18" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▦  Duplicate Finder" FontSize="16" FontWeight="Bold"/><TextBlock Text="Find identical files using SHA-256" Foreground="#AAB8C9" Margin="0,10,0,8"/><TextBlock Text="Open tool →" Foreground="#70A8FF"/></StackPanel></Button>
       <Button Tag="File Hashing" Click="Nav_Click" Background="#243244" Foreground="White" Height="132" Margin="0,0,0,12" Padding="18" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="#  File Hashing" FontSize="16" FontWeight="Bold"/><TextBlock Text="Calculate file integrity checksums" Foreground="#AAB8C9" Margin="0,10,0,8"/><TextBlock Text="Open tool →" Foreground="#70A8FF"/></StackPanel></Button>
       <Button Tag="Folder Compare" Click="Nav_Click" Background="#243244" Foreground="White" Height="132" Margin="0,0,12,12" Padding="18" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⇄  Folder Compare" FontSize="16" FontWeight="Bold"/><TextBlock Text="Compare two folder structures" Foreground="#AAB8C9" Margin="0,10,0,8"/><TextBlock Text="Open tool →" Foreground="#70A8FF"/></StackPanel></Button>
       <Button Tag="Image Resizer" Click="Nav_Click" Background="#243244" Foreground="White" Height="132" Margin="0,0,12,12" Padding="18" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▧  Image Resizer" FontSize="16" FontWeight="Bold"/><TextBlock Text="Resize images by pixels or percentage" Foreground="#AAB8C9" Margin="0,10,0,8"/><TextBlock Text="Open tool →" Foreground="#70A8FF"/></StackPanel></Button>
       <Button Tag="Format Converter" Click="Nav_Click" Background="#243244" Foreground="White" Height="132" Margin="0,0,0,12" Padding="18" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="⇩  Format Converter" FontSize="16" FontWeight="Bold"/><TextBlock Text="Convert common image formats" Foreground="#AAB8C9" Margin="0,10,0,8"/><TextBlock Text="Open tool →" Foreground="#70A8FF"/></StackPanel></Button>
       <Button Tag="Folder Sync" Click="Nav_Click" Background="#243244" Foreground="White" Height="132" Margin="0,0,12,12" Padding="18" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="↻  Folder Sync" FontSize="16" FontWeight="Bold"/><TextBlock Text="Copy a folder onto another" Foreground="#AAB8C9" Margin="0,10,0,8"/><TextBlock Text="Open tool →" Foreground="#70A8FF"/></StackPanel></Button>
       <Button Tag="Image Compress" Click="Nav_Click" Background="#243244" Foreground="White" Height="132" Margin="0,0,12,12" Padding="18" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▣  Image Compress" FontSize="16" FontWeight="Bold"/><TextBlock Text="JPEG and WebP with a quality setting" Foreground="#AAB8C9" Margin="0,10,0,8"/><TextBlock Text="Open tool →" Foreground="#70A8FF"/></StackPanel></Button>
       <Button Tag="PDF Tools" Click="Nav_Click" Background="#243244" Foreground="White" Height="132" Margin="0,0,0,12" Padding="18" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▤  PDF Tools" FontSize="16" FontWeight="Bold"/><TextBlock Text="Merge, split, or recompress PDFs" Foreground="#AAB8C9" Margin="0,10,0,8"/><TextBlock Text="Open tool →" Foreground="#70A8FF"/></StackPanel></Button>
       <Button Tag="Archives" Click="Nav_Click" Background="#243244" Foreground="White" Height="132" Margin="0,0,12,12" Padding="18" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="▩  Archives" FontSize="16" FontWeight="Bold"/><TextBlock Text="Create, list, and extract ZIP or 7Z" Foreground="#AAB8C9" Margin="0,10,0,8"/><TextBlock Text="Open tool →" Foreground="#70A8FF"/></StackPanel></Button>
       <Button Tag="File Metadata" Click="Nav_Click" Background="#243244" Foreground="White" Height="132" Margin="0,0,12,12" Padding="18" HorizontalContentAlignment="Left"><StackPanel><TextBlock Text="☰  File Metadata" FontSize="16" FontWeight="Bold"/><TextBlock Text="Size, dates, and image or PDF details" Foreground="#AAB8C9" Margin="0,10,0,8"/><TextBlock Text="Open tool →" Foreground="#70A8FF"/></StackPanel></Button>
      </UniformGrid>
     </StackPanel>
     <Border x:Name="ToolHost" Visibility="Collapsed" Background="#1D2A3A" BorderBrush="#34465C" BorderThickness="1" CornerRadius="12" Padding="22">
      <StackPanel>
       <TextBlock x:Name="ToolDescription" Foreground="#AAB8C9" Margin="0,0,0,15"/>
       <StackPanel x:Name="ToolControls"/>
       <TextBlock Text="RESULTS" Foreground="#91A5BC" FontSize="10" FontWeight="Bold" Margin="0,18,0,7"/>
       <TextBox x:Name="OutputBox" MinHeight="190" MaxHeight="360" IsReadOnly="True" FontFamily="Consolas" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto"/>
       <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button Content="Copy results" Click="Copy_Click" Background="#3985F5" Foreground="White"/>
        <Button Content="Clear results" Click="Clear_Click" Background="#35465B" Foreground="White"/>
       </StackPanel>
       <TextBlock x:Name="StatusText" Foreground="#91D6C2" Margin="0,10,0,0"/>
      </StackPanel>
     </Border>
    </Grid>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>