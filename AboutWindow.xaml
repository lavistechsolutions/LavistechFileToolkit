<Window x:Class="LavistechFileToolkit.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="#111B29" Foreground="#EAF0F8" FontFamily="Segoe UI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="48"/>
        </Grid.RowDefinitions>

        <StackPanel Margin="28,24,28,16">
            <TextBlock Text="Lavistech File Toolkit" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock x:Name="VersionText" FontSize="14" Margin="0,4,0,0" Foreground="#9AAABD"/>
            <TextBlock Text="Windows PC, 64-bit" FontSize="14" Margin="0,0,0,14" Foreground="#9AAABD"/>
            <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,8"
                       Text="A file management and conversion toolbox, put together by Lavistech Solutions."/>
            <TextBlock TextWrapping="Wrap" LineHeight="20" Margin="0,0,0,14" Foreground="#9AAABD"
                       Text="Rename, sync, hash, compress, and archive files on this PC. Nothing is uploaded."/>
            <TextBlock x:Name="FeedbackLink" Text="Feedback" Foreground="#70A8FF" Cursor="Hand" TextDecorations="Underline"/>
        </StackPanel>

        <Border Grid.Row="1" Background="#1B2838">
            <UniformGrid Columns="3">
                <TextBlock x:Name="LicenseLink" Text="License" Style="{StaticResource AboutLink}"/>
                <TextBlock x:Name="EulaLink" Text="EULA" Style="{StaticResource AboutLink}"/>
                <TextBlock x:Name="NoticesLink" Text="Third-party notices" Style="{StaticResource AboutLink}"/>
            </UniformGrid>
        </Border>
    </Grid>
</Window>
